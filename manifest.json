{
  "manifest_version": 2,
  "name": "Lethoryale",
  "version": "0.1.0",
  "description": "Keeps cookies for chosen sensitive domains encrypted while unused. The key lives in memory, never on disk.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lethoryale@etheryale.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "<all_urls>"
  ],
  "background": {
    "page": "src/background.html",
    "persistent": true
  },
  "browser_action": {
    "default_title": "Lethoryale",
    "default_popup": "popup/popup.html"
  }
}
